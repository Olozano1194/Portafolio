#!/bin/sh
# AGENTS.md R7: no direct push to main or master.
# Wired with: git config core.hooksPath .githooks
set -e

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$GENTLE_ALLOW_MAIN_PUSH" = "1" ]; then
        printf 'pre-push: GENTLE_ALLOW_MAIN_PUSH=1 set — allowing push to %s (emergency override).\n' "$remote_ref"
      else
        printf 'pre-push: push directo a %s bloqueado (AGENTS.md R7).\n' "$remote_ref"
        printf 'Abre un pull request en su lugar.\n'
        blocked=1
      fi
      ;;
  esac
done

if [ "$blocked" -ne 0 ]; then
  exit 1
fi
